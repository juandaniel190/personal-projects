CUBEJS_DB_SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
CUBEJS_DB_NAME=snowflake_db_name
CUBEJS_DB_SNOWFLAKE_WAREHOUSE=warehouse_name
CUBEJS_DB_SNOWFLAKE_ROLE="role_name"

CUBEJS_DB_USER=user_name@eventbrite.com
CUBEJS_DB_SNOWFLAKE_ACCOUNT=account_name
CUBEJS_DB_SNOWFLAKE_PRIVATE_KEY_PATH=path_to_private_key
CUBEJS_DB_SNOWFLAKE_CLIENT_SESSION_KEEP_ALIVE=true
CUBEJS_DEV_MODE=true
CUBEJS_DB_TYPE=snowflake
CUBEJS_API_SECRET=your_cube_api_secret
CUBEJS_EXTERNAL_DEFAULT=true
CUBEJS_SCHEDULED_REFRESH_DEFAULT=true
CUBEJS_SCHEMA_PATH=model
CUBESQL_SQL_PUSH_DOWN=true
CUBEJS_ROLLUP_ONLY=false
CUBEJS_SCHEDULED_REFRESH_TIMEZONES='America/Los_Angeles'
CUBEJS_TESSERACT_SQL_PLANNER=false

CUBEJS_PG_SQL_PORT=15432
CUBEJS_SQL_PASSWORD=your_password
CUBEJS_SQL_USER=your_user

CUBEJS_CONCURRENCY=5
CUBEJS_DB_MAX_POOL=20

CUBEJS_DB_EXPORT_BUCKET=your_bucket_name
CUBEJS_DB_EXPORT_BUCKET_TYPE=s3
CUBEJS_DB_EXPORT_BUCKET_AWS_KEY=your_aws_key
CUBEJS_DB_EXPORT_BUCKET_AWS_SECRET=your_aws_secret
CUBEJS_DB_EXPORT_BUCKET_AWS_REGION=your_aws_region

CUBESTORE_AWS_ACCESS_KEY_ID=your_aws_key
CUBESTORE_AWS_SECRET_ACCESS_KEY=your_aws_secret

PRE_AGGREGATIONS_ENABLED=false
DEFAULT_DATABASE=your_database_name
